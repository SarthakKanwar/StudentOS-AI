# StudentOS — environment variable template
#
# Copy to .env and fill in real values locally.
# NEVER commit .env or put real values in this file.
# Placeholders below are intentionally non-functional.

# ── Microsoft Foundry (runtime AI layer) ──────────────────────────
# Backend only. These must never reach the browser.
FOUNDRY_ENDPOINT=<your-foundry-endpoint>
FOUNDRY_API_KEY=<your-foundry-api-key>
FOUNDRY_CHAT_DEPLOYMENT=<your-chat-model-deployment-name>
FOUNDRY_EMBEDDING_DEPLOYMENT=<your-embedding-model-deployment-name>
FOUNDRY_API_VERSION=<api-version>

# ── Supabase (auth, database, vector store, file storage) ─────────
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# SERVICE ROLE KEY BYPASSES ROW LEVEL SECURITY — BACKEND ONLY.
# Never expose this to the frontend or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Backend application ───────────────────────────────────────────
APP_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Retrieval, chunking and grounding thresholds ──────────────────
# NOT here. Those values live in version-controlled config/retrieval.yaml
# so that evaluation runs stay reproducible (see requirements.md NFR-13).
# This file is for secrets and deployment-specific values only.

# ── Cost and abuse controls ───────────────────────────────────────
DAILY_TOKEN_BUDGET=<max-tokens-per-day>
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200
MAX_UPLOAD_SIZE_MB=20
MAX_QUESTION_LENGTH=1000

# ── Frontend (VITE_ variables are inlined into the client bundle) ──
# Only values safe to be public may appear here.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=<your-supabase-project-url>
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
