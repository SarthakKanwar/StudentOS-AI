# Environment variables
# .env.* covers .env.local, .env.production, .env.staging, etc.
# .env.example is deliberately re-included so the template stays tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.tsbuildinfo
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tool state
.claude/

# OS and editor files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.vim/

# Common secret/key files
*.pem
*.key
*.pub
*.pfx
*.p12
secrets/
.aws/
.gcloud/

# IDE specific
.eslintcache

# Testing
.nyc_output/
coverage/
.test-cache/

# Runtime
tmp/
temp/
cache/

# Local demo storage (SQLite fallback when Supabase is not provisioned)
data/
*.db
